{
  "name": "calendar-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "packageManager": "npm@12.2.2",
  "engines": {
    "node": "26.13.0",
    "npm": "12.2.2"
  },
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "lint": "eslint . && prettier --check . && tsp format --check api/main.tsp",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspace frontend",
    "build": "npm run api:generate && npm run build --workspace frontend"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@hey-api/openapi-ts": "0.99.0",
    "@typespec/compiler": "1.18.0",
    "@typespec/http": "1.18.0",
    "@typespec/openapi": "1.18.0",
    "@typespec/openapi3": "1.18.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
